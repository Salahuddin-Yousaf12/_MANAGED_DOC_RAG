# Milvus Configuration
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=document_chunks

# PostgreSQL Configuration
POSTGRES_HOST=vector-postgres
POSTGRES_PORT=5432
POSTGRES_USER=vectoruser
POSTGRES_PASSWORD=vectorpass
POSTGRES_DB=vector_metadata

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# Doc Upload Service (on shared network)
DOC_UPLOAD_SERVICE_URL=http://doc_upload_api:8080
DOC_UPLOAD_TIMEOUT=30
